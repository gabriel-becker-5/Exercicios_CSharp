@model List<Tarefa>

@{
    ViewData["Title"] = "Lista de Tarefas";
}

<h4><div class="title">Lista de Tarefas</div></h4>

@foreach (Tarefa tarefa in Model)
{
    <div class="lista-de-tarefas">
        @if (tarefa.Concluida == true)
        {
            <p>Tarefa: @tarefa.Titulo - Status: ✅ </p>
        }
        else
        {
            <p>Tarefa: @tarefa.Titulo - Status: ❌ </p>
        }
    </div>
}