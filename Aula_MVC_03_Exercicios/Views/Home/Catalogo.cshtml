@model List<Produto>

@{
    ViewData["Title"] = "Catálogo de Produtos";
}

<div class="text-center">
    <h1 class="title-display">Catálogo de Produtos</h1>

    @{
        decimal total = Model.Sum(m => m.Preco);
        int qtdProdutos = Model.Count();
    }

    <div class="cabecalho-catalogo">
        <p>Preço Total do Catálogo: R$ @total</p>
        <p>Quantidade de Produtos: @qtdProdutos</p>
    </div>

    @foreach (var grupo in Model.GroupBy(p => p.Categoria))
    {
        <div class="cabecalho-categoria"><p>Categoria: @grupo.Key </p></div>
        <div class="cards_produtos">
            @foreach (var produto in grupo)
            {
                <div class="card_produto">
                    <partial name="_CardProduto" model="produto" />
                </div>
            }
        </div>
    }
</div>