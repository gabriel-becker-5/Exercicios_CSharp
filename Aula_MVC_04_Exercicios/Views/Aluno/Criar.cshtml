@model Aluno

@{
    ViewData["Title"] = "Matricular Aluno";
}

<style>
    table, th, td {
        border: 1px solid gray;
        width: 950px;
        text-wrap: nowrap;
    }

    h4 {
        font-weight: 800;
    }

    .body-matriculas {
        justify-items: center;
    }

    .divisorias {
        height: 15px;
    }

    .camposNomeAluno, .camposEmailAluno {
        display: flex;
        gap: 110px;
    }

    .camposTelefoneAluno {
        display: flex;
        gap: 95px;
    }

    .camposDataNascimentoAluno {
        display: flex;
        gap: 10px;
    }

    .menu-opcoes-aluno {
        display: flex;
        gap: 15px;
    }
</style>

<partial name="_MenuAluno" />

<div class="divisorias"></div>
<h4>Matricular Aluno</h4>
<div class="containerCamposMatricula">

    <form asp-controller="aluno" asp-action="criar" method="post">
        <div class="divisorias"></div>
        <div class="camposNomeAluno">
            <div class="labelnomealuno">Nome:</div>
            <div class="inputnomealuno"><input id="nomeAluno" asp-for="Nome" maxlength="300" placeholder="Nome completo" size="40" type="text" value=""></div>
        </div>
        <div class="divisorias"></div>
        <div class="camposEmailAluno">
            <div class="labelemailaluno">E-mail:</div>
            <div class="inputEmailAluno"><input id="emailAluno" asp-for="Email" maxlength="300" placeholder="E-mail" size="40" type="text" value=""></div>
        </div>
        <div class="divisorias"></div>
        <div class="camposDataNascimentoAluno">
            <div class="labeldataNascimentoaluno">Data de Nascimento:</div>
            <div class="inputDataNascimentoAluno"><input id="dataNascimentoAluno" asp-for="DataNascimento" maxlength="300" placeholder="Data (DD/MM/AAAA)" size="40" type="date" value=""></div>
        </div>
        <div class="divisorias"></div>
        <div class="camposTelefoneAluno">
            <div class="labelTelefoneAluno">Telefone:</div>
            <div class="inputTelefoneAluno"><input id="telefoneAluno" maxlength="300" asp-for="Telefone" placeholder="Telefone / Celular" size="40" type="text" value=""></div>
        </div>
        <div class="divisorias"></div>

        <button type="submit">Cadastrar</button>
    </form>
</div>