<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Aula_MVC_04_Exercicios</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Aula_MVC_04_Exercicios.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Aula_MVC_04_Exercicios</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <div>
                                    <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                                        <button type="submit" class="nav-link btn btn-link text-dark">Sair</button>
                                    </form>
                                </div>
                            </li>
                            <li class="nav-item">
                                @if (User.IsInRole("Admin"))
                                {
                                    <div class="nav-link btn btn-link text-dark"><a href="/Admin">Painel Admin</a></div>
                                }
                            </li>
                            <li class="nav-item">
                                <div style="margin-top:9px; margin-left:15px;"><p>Olá @User.Identity.Name</p></div>
                            </li>

                            <li class="nav-item">
                                <div class="badge">
                                    @{
                                        string badgeColor = null;
                                        string badgeLabel = null;
                                        if (User.IsInRole("Admin"))
                                        {
                                            badgeColor = "#000000";
                                            badgeLabel = "Admin";
                                        }
                                        else if (User.IsInRole("Professor"))
                                        {
                                            badgeColor = "#d0850b";
                                            badgeLabel = "Professor";
                                        }
                                        else
                                        {
                                            badgeColor = "#105397";
                                            badgeLabel = "Aluno";
                                        }
                                    }

                                    <svg width="120" height="32" viewBox="0 0 120 32">
                                        <rect x="1" y="1" width="118" height="30" rx="15" fill="@badgeColor" />
                                        <text x="60" y="21" text-anchor="middle" fill="white" font-size="13" font-weight="bold">@badgeLabel</text>
                                    </svg>
                                </div>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <div class="nav-link text-dark"><a href="/Identity/Account/Login">Logar</a></div>
                            </li>
                            <li class="nav-item">
                                <div class="nav-link text-dark"><a href="/Identity/Account/Register">Registrar</a></div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Aula_MVC_04_Exercicios - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
