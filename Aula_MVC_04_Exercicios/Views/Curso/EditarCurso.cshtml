@model Curso

@{
    ViewData["Title"] = "Editar Curso";
}

<style>
    .CamposNomeCurso, .CamposCargaHoraria {
        display: flex;
        gap: 20px;
    }

    .CamposCadastrarCurso {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .messageDiasCurso {
        color: darkred;
        font-size: 12.5px;
    }
</style>

<div class="containerPagina">
    <partial name="_MenuCurso" />
    <p></p>
    <h4>Editar Curso</h4>
    <p></p>
    <form asp-controller="curso" asp-action="editar" asp-route-idCurso="@Model.Id" method="post">
        <div asp-validation-summary="All"></div>
        <div class="CamposCadastrarCurso">
            <div class="CamposNomeCurso">
                <div class="labelNomeCurso">Nome do Curso:</div>
                <input class="inputNomeCurso" asp-for="Nome" type="text" placeholder="Nome do Curso" value="@Model.Nome" />
            </div>
            <div class="CamposCargaHoraria">
                <div class="labelCargaHoraria">Carga Horária:</div>
                <input class="inputCargaHoraria" asp-for="CargaHoraria" type="number" placeholder="Carga Horária" value="@Model.CargaHoraria" />
            </div>
            <p class="messageDiasCurso">Equivale a aproximadamente @ViewBag.diasDeCurso dias úteis de aula.</p>
        </div>
        <button type="submit" class="buttonCadastrar">Editar</button>
    </form>
</div>