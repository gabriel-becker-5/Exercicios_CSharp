@model List<Curso>

@{
    ViewData["Title"] = "Index";
    int qtdCursosCadastrados = Model.Count();
    var msgSucessoCadastrarCurso = TempData["msg_Create_Sucess"];
    var msgSucessoEditarCurso = TempData["msg_Edit_Sucess"];
    var msgExclusaoCurso = TempData["msg_Delete"];
}

<style>
    table, th, td {
        border: 1px solid gray;
        text-align: center;
    }

    .tableCursos {
        color: white;
        background: black;
        width: 700px;
    }

    td {
        background: lightblue;
        color: black;
    }

    .cursosCadastrados {
        font-weight: 800;
        text-align: left;
    }

    .barraAcoesCurso {
        display: flex;
        gap: 30px;
    }

    .editdeleteCursos, .pesquisaCurso {
        display: flex;
        gap: 7px;
    }
</style>

<div class="containerPagina">

    <partial name="_MenuCurso" />
    <p></p>

    <h3>Lista de Cursos</h3>
    <p></p>




    <form method="get" asp-controller="curso" asp-action="index">
    <div class="barraAcoesCurso">
        <div class="pesquisaCurso">
            <a>Curso: </a>
            <input placeholder="Curso" name="nomeCurso" value="" type="text" />
            <button type="submit">Pesquisar</button>
        </div>
    </form>

        <form method="get" asp-controller="curso">
            <div class="editdeleteCursos">
                <a>ID do Curso: </a>
                <input placeholder="ID" name="idCurso" value="" type="number" />
                <button asp-action="editar" type="submit">Editar</button>
                <button asp-action="excluir" type="submit">Excluir</button>
            </form>
        </div>
    </div>

    <p></p>

    <div class="cursosCadastrados">Cursos Cadastrados: @qtdCursosCadastrados</div>
    <p></p>
    @if (msgSucessoCadastrarCurso != null ||
     msgSucessoEditarCurso != null ||
     msgExclusaoCurso != null)
    {
        <p>@msgSucessoCadastrarCurso</p>
        <p>@msgSucessoEditarCurso</p>
        <p>@msgExclusaoCurso</p>
    }
    <table class="tableCursos">
        <thead>
            <th style="width: 35px;">ID</th>
            <th style="width: auto;">Curso</th>
            <th style="width: 80px;">Carga Horária</th>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td style="text-wrap: wrap;">@item.Nome</td>
                    <td>@item.CargaHoraria</td>
                </tr>
            }
        </tbody>
    </table>
</div>